+/* Check whether c begins an exact Unicode operator.  The tokenizer reads
+   UTF-8 a byte at a time, while the generated token lookup supports at most
+   three bytes.  On failure, restore every byte except c. */
+static int
+tok_unicode_operator(struct tok_state *tok, int c, int *token_length)
+{
+    assert(c >= 128);
+
+    int c2 = tok_nextc(tok);
+    int current_token = _PyToken_TwoChars(c, c2);
+    if (current_token != OP) {
+        *token_length = 2;
+        return current_token;
+    }
+
+    /* Three- and four-byte UTF-8 characters begin at 0xE0 or above.  Only
+       three-byte exact tokens are currently representable by _PyToken_*(). */
+    if (c >= 0xE0) {
+        int c3 = tok_nextc(tok);
+        current_token = _PyToken_ThreeChars(c, c2, c3);
+        if (current_token != OP) {
+            *token_length = 3;
+            return current_token;
+        }
+        tok_backup(tok, c3);
+    }
+
+    tok_backup(tok, c2);
+    *token_length = 1;
+    return OP;
+}
